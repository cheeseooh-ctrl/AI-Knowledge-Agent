{
  "project_name": "AI Daily Knowledge Agent",
  "version": "2.0.0",
  "sources": {
    "hackernews": {
      "enabled": true,
      "min_points": 25,
      "max_items": 10,
      "keywords": [
        "AI",
        "LLM",
        "Agent",
        "GPT",
        "Claude",
        "Gemini",
        "DeepSeek",
        "Llama",
        "Mistral",
        "OpenAI",
        "Anthropic",
        "GPU",
        "Nvidia",
        "diffusion",
        "reasoning"
      ]
    },
    "huggingface_papers": {
      "enabled": true,
      "max_items": 8
    },
    "github_trending": {
      "enabled": true,
      "max_items": 6,
      "topics": ["llm", "agent", "ai", "rag", "mcp"]
    },
    "rss_feeds": {
      "enabled": true,
      "max_items_per_feed": 3,
      "feeds": [
        {
          "name": "OpenAI News",
          "url": "https://openai.com/news/rss.xml"
        },
        {
          "name": "Hugging Face Blog",
          "url": "https://huggingface.co/blog/feed.xml"
        },
        {
          "name": "Simon Willison Weblog",
          "url": "https://simonwillison.net/atom/everything/"
        },
        {
          "name": "Google AI Blog",
          "url": "https://blog.google/technology/ai/rss/"
        }
      ]
    }
  },
  "memory": {
    "enabled": true,
    "history_retention_days": 14,
    "user_profile": {
      "role": "AI 架构师 / AI 产品经理 (FDE 交付专家)",
      "interests": [
        "agent",
        "mcp",
        "local-models",
        "rag",
        "open-source",
        "tool-use",
        "harness",
        "agent-loop",
        "fde",
        "deepseek-harness",
        "vibe-coding",
        "ontology",
        "crawl4ai",
        "spec-driven",
        "observability",
        "webmcp"
      ],
      "disliked_topics": [
        "crypto",
        "nft",
        "funding-only",
        "metaverse",
        "web3"
      ],
      "tone_preference": "极客硬核、重实战、无公关套话"
    }
  },
  "deep_reader": {
    "enabled": true,
    "max_deep_items": 3
  },
  "router": {
    "enabled": true,
    "pass_threshold": 80,
    "max_revision_rounds": 2
  },
  "summarizer": {
    "default_model": "gemini-2.5-flash",
    "fallback_model": "gemini-2.0-flash",
    "temperature": 0.25,
    "max_output_tokens": 4096
  },
  "notification": {
    "feishu": {
      "enabled": false,
      "webhook_url": "",
      "card_theme": "blue"
    }
  },
  "output": {
    "dir": "./reports",
    "filename_format": "{date}_AI_Daily_Briefing.md",
    "save_raw_json": true,
    "git_auto_push": false
  }
}
